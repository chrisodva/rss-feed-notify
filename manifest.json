{
  "manifest_version": 2,
  "name": "RSS Bookmark Checker",
  "version": "0.2.0",
  "description": "Checks RSS feeds for bookmarks in a folder and marks updated sites.",
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "activeTab",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "RSS Bookmark Checker",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rss-bookmark-checker@example.local"
    }
  }
}
